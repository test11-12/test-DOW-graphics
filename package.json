{
  "name": "ten-wins-in-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ten short animated graphics, one for each of ten American defense-technology wins, drawn from reported figures.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/build.mjs --release && node tools/copy.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "check": "tsc --noEmit -p .",
    "test": "node --test tests/unit/*.test.ts && node tests/e2e.mjs && node tools/lint-layout.mjs --step 0.5",
    "test:unit": "node --test tests/unit/*.test.ts",
    "shoot": "node tools/shoot.mjs",
    "verify": "node tools/verify.mjs",
    "lint:layout": "node tools/lint-layout.mjs",
    "copy": "node tools/copy.mjs",
    "export": "node tools/export-pdf.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0 || ^7.0.0"
  }
}
